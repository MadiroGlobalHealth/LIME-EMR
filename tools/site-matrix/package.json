    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "js-yaml": "4.1.0",
    "lucide-react": "0.577.0",
    "radix-ui": "1.4.3",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.15.30",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
