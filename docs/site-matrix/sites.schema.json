{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MadiroGlobalHealth/LIME-EMR/docs/site-matrix/sites.schema.json",
  "title": "LIME EMR site matrix (sites.yaml), version 2",
  "description": "Setup and plans of every LIME EMR site. Checked by the Site Matrix app before each save, by scripts/site-profiles/validate.py, by the Site matrix workflow, and by editors that read the yaml-language-server comment at the top of sites.yaml. Keys starting with x- are free extensions (anything allowed) for trying a new field before it is formalised.",
  "type": "object",
  "required": ["version", "orgs", "vocab", "sites", "catalog"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "version": { "const": 2 },
    "orgs": {
      "description": "Organisations (or operational centres) that run sites, keyed by id.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "notes": { "$ref": "#/$defs/text" }
        }
      }
    },
    "vocab": {
      "description": "Editable lists that the app and the checks read, so new milestones or integrations need no code change.",
      "type": "object",
      "required": ["milestones", "integrations"],
      "additionalProperties": false,
      "properties": {
        "milestones": { "$ref": "#/$defs/vocabList" },
        "integrations": { "$ref": "#/$defs/vocabList" }
      }
    },
    "how_to_apply": {
      "description": "Where each item is configured in the repo.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "sites": {
      "description": "One entry per site, keyed by its id (the sites/<id> folder once it exists).",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/site" }
    },
    "catalog": {
      "type": "object",
      "required": ["forms", "modules"],
      "additionalProperties": false,
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "name", "program"],
            "additionalProperties": false,
            "properties": {
              "code": { "$ref": "#/$defs/formCode" },
              "name": { "type": "string", "minLength": 1 },
              "program": { "type": "string", "minLength": 1 },
              "in_library": { "type": "boolean", "description": "false: referenced by sites but not in the distro library yet." }
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "apps"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1 },
              "apps": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$" },
    "formCode": { "type": "string", "pattern": "^F\\d{2,3}$", "description": "F01 to F999." },
    "need": { "enum": ["needed", "not_needed", "on_hold"] },
    "text": { "type": ["string", "null"] },
    "textList": { "type": ["array", "null"], "items": { "type": "string" } },
    "url": { "type": ["string", "null"], "pattern": "^https?://" },
    "date": {
      "description": "A day (2026-11-30), a month (2026-11) or a year (2026).",
      "type": ["string", "null"],
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "vocabList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "hint": { "type": "string" }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "done": { "type": "boolean" },
        "approx": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "formDecision": {
      "description": "Short form: just the need (F11: needed). Long form: an object, for a note or a site-specific form.",
      "oneOf": [
        { "$ref": "#/$defs/need" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "need": { "$ref": "#/$defs/need" },
            "note": { "type": "string" },
            "custom": { "const": true, "description": "A form made for this site, not in the library yet. Its key is a site-specific code." },
            "name": { "type": "string", "minLength": 1 },
            "program": { "type": "string" }
          },
          "if": { "required": ["custom"] },
          "then": { "required": ["name"] }
        }
      ]
    },
    "identifier": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "format": { "type": "string", "description": "Format shown to users, e.g. 5 digits." }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "need": { "$ref": "#/$defs/need" },
        "target": { "$ref": "#/$defs/text", "description": "The system or program data goes to, e.g. a DHIS2 tracker program." },
        "note": { "type": "string" }
      }
    },
    "site": {
      "type": "object",
      "required": ["name", "org", "status"],
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "org": { "$ref": "#/$defs/id", "description": "Key in `orgs`." },
        "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 code, e.g. KE." },
        "status": { "enum": ["live", "preparation", "planned", "closed"] },
        "phase": { "$ref": "#/$defs/text" },
        "focal_point": { "$ref": "#/$defs/text", "description": "Person to ask about this site's setup." },
        "reviewed": { "$ref": "#/$defs/date", "description": "When the requirements were last reviewed with the site." },
        "environments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uat": { "$ref": "#/$defs/url" },
            "prod": { "$ref": "#/$defs/url" }
          }
        },
        "milestones": {
          "description": "Keyed by ids from vocab.milestones.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/milestone" }
        },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id_prefix": { "$ref": "#/$defs/text" },
            "identifiers": {
              "description": "Identifiers asked at registration besides the MSF ID.",
              "type": ["array", "null"],
              "items": { "$ref": "#/$defs/identifier" }
            },
            "extra_fields": { "$ref": "#/$defs/textList" },
            "address": { "$ref": "#/$defs/textList" },
            "languages": {
              "type": ["array", "null"],
              "items": { "type": "string", "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$", "description": "OpenMRS locale: ISO 639 language code, optionally _COUNTRY (en, fr, ar, en_GB)." }
            },
            "custom_form": { "type": "boolean", "description": "The site needs its own registration form." }
          }
        },
        "locations": { "$ref": "#/$defs/textList" },
        "services": { "$ref": "#/$defs/textList" },
        "forms_default": { "$ref": "#/$defs/need", "description": "Need of every library form not listed in `forms` (not_needed when the requirements list is exhaustive)." },
        "forms": {
          "description": "Decisions per form: library codes (F11) or site-specific codes with custom: true.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/formDecision" }
        },
        "modules": {
          "description": "Decisions per module, keyed by catalog.modules ids.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/need" }
        },
        "integrations": {
          "description": "Keyed by ids from vocab.integrations.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/integration" }
        },
        "open_items": { "type": "array", "items": { "type": "string" } },
        "notes": { "$ref": "#/$defs/text" },
        "detected": {
          "description": "Generated by scripts/site-profiles/extract.py from the repo. Do not edit by hand.",
          "type": "object"
        }
      }
    }
  }
}
